{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Token-driven component layer shared by every site. Ships raw source — consumers transpile it.",
  "exports": {
    "./styles/base.css": "./src/styles/base.css",
    "./lib/cn": "./src/lib/cn.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@repo/config": "*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
