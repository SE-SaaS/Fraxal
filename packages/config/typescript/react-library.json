{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@repo React library",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    // `react-jsx` (not `preserve`) because this config only ever typechecks —
    // the package ships raw source and Next transpiles it downstream.
    "jsx": "react-jsx"
  }
}
